# DigitalOcean 서버 .env 템플릿 (플레이스홀더 — 실제 값은 GitHub Secrets/비밀저장소)
# CI가 배포 시 이 형태로 서버에 생성. 절대 실제 시크릿을 커밋하지 말 것.

# --- 레지스트리 (DOCR) ---
DOCKER_REGISTRY=registry.digitalocean.com/licensekaki
IMAGE_TAG=latest

# --- Spring ---
SPRING_PROFILES_ACTIVE=prod          # 개발은 default
SQL_INIT_MODE=never

# --- DB (DO Managed MySQL, SSL 필수) ---
# 예: jdbc:mysql://db-mysql-sgp1-xxxxx.b.db.ondigitalocean.com:25060/bluelight?useSSL=true&requireSSL=true&serverTimezone=Asia/Singapore&characterEncoding=UTF-8&trustServerCertificate=true
DB_URL=<do-managed-mysql-jdbc-url>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

# --- 보안 (값 유지) ---
JWT_SECRET=<unchanged-jwt-secret>
FILE_ENCRYPTION_KEY=<unchanged-aes-256-key>   # ★ 기존과 동일해야 기존 파일 복호화 가능

# --- 파일 저장 (Spaces) ---
FILE_STORAGE_TYPE=s3
AWS_S3_BUCKET=<spaces-bucket-name>
AWS_S3_REGION=sgp1
AWS_S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
AWS_ACCESS_KEY_ID=<spaces-access-key>
AWS_SECRET_ACCESS_KEY=<spaces-secret-key>

# --- 이메일 (Resend — 변경 없음) ---
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=<resend-api-key>
MAIL_FROM=noreply@licensekaki.com
MAIL_FROM_NAME=LicenseKaki
MAIL_SMTP_ENABLED=true

# --- URL/CORS (도메인 유지) ---
CORS_ALLOWED_ORIGINS=https://licensekaki.com      # 개발: https://dev.licensekaki.com
PASSWORD_RESET_BASE_URL=https://licensekaki.com   # 개발: https://dev.licensekaki.com

# --- SLD Agent ---
SLD_AGENT_SERVICE_KEY=<service-key>
GEMINI_API_KEY=<gemini-key>

# --- SLD Agent용 MySQL 파라미터 (CI가 DB_URL에서 자동 추출해 append) ---
# MYSQL_HOST=...
# MYSQL_PORT=25060
# MYSQL_DATABASE=bluelight
