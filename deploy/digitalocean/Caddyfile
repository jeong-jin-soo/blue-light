# 올인원 드롭릿 TLS 리버스 프록시 (DO LB 대체)
# Let's Encrypt 자동 발급/갱신(HTTP-01). frontend 컨테이너(docker network)로 프록시.
# 도메인은 환경별로 다르므로 {$SITE_ADDRESS} 로 주입한다(caddy 컨테이너 env).
#   - prod: SITE_ADDRESS="licensekaki.com, www.licensekaki.com"
#   - dev : SITE_ADDRESS="dev.licensekaki.com"
# 사전조건: 해당 도메인 A 레코드가 이 드롭릿 IP를 가리킬 것, 옛 IPv6(AAAA) 없을 것.

{
	email admin@licensekaki.com
}

{$SITE_ADDRESS} {
	# www → apex 301. 둘 다 200 을 주면 Google 이 중복 호스트로 보고
	# "적절한 표준 태그가 포함된 대체 페이지"로 www 를 색인에서 제외한다.
	# (dev 는 SITE_ADDRESS 에 www 가 없어 이 매처가 걸리지 않는다.)
	@www host www.licensekaki.com
	redir @www https://licensekaki.com{uri} permanent

	encode gzip
	reverse_proxy frontend:80
}
